---
import { config } from '../../config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPosts, groupByYear, postUrl } from '../../utils/posts';
const posts = await getPosts();
---

<BaseLayout
  title={config.pages.posts.title}
  description={config.pages.posts.description}
>
  <h1 class="mb-8 text-3xl font-bold tracking-tight wrap-anywhere sm:text-4xl">
    {config.pages.posts.title}
  </h1>
  {groupByYear(posts).map(([year, entries]) => (
    <section class="space-y-3 not-last:mb-8" aria-labelledby={`year-${year}`}>
      <h2
        id={`year-${year}`}
        class="flex items-center gap-3 text-xl font-semibold"
      >
        {year}
        <span class="inline-flex rounded-full bg-muted px-2 py-0.5 text-xs font-normal text-muted-foreground">
          {config.pages.posts.postCount(entries.length)}
        </span>
      </h2>
      <ul>
        {entries.map((post) => (
          <li>
            <a
              class="group flex items-baseline gap-3 border-b border-border py-3"
              href={postUrl(post.id)}
            >
              <time
                class="shrink-0 text-xs text-muted-foreground tabular-nums"
                datetime={post.data.published.toISOString()}
              >
                {formatDate(post.data.published, true)}
              </time>
              <span class="min-w-0 text-base wrap-anywhere transition-colors group-hover:text-accent-foreground group-focus-visible:text-accent-foreground">
                {post.data.title}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  {posts.length === 0 && (
    <p class="text-sm text-muted-foreground">{config.common.emptyPosts}</p>
  )}
</BaseLayout>
