---
import { IconArrowRight } from '@tabler/icons-astro';

import { config } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';

const { title, heading, message, back } = config.pages[404];
---

<BaseLayout title={title} noindex>
  <div class="space-y-4 rounded-lg px-4 py-12 text-center sm:py-16">
    <p class="text-6xl font-bold text-muted-foreground" aria-hidden="true">
      404
    </p>
    <h1 class="text-3xl font-bold">{heading}</h1>
    <p class="text-base leading-relaxed text-muted-foreground">{message}</p>
    <a
      class="button bg-accent text-accent-foreground"
      href={config.pages.home.href}
    >
      {back}
      <IconArrowRight size={16} aria-hidden="true" />
    </a>
  </div>
</BaseLayout>
