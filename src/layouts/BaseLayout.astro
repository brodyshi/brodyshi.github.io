---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { config } from '../config';

import 'vitepress/dist/client/theme-default/styles/vars.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  post?: {
    title: string;
    published: Date;
    updated?: Date | undefined;
    tags: string[];
  };
  noindex?: boolean;
}
const {
  title,
  description = config.pages.home.description,
  post,
  noindex = false,
} = Astro.props;
const pageTitle = title || config.name;
const canonical = new URL(Astro.url.pathname, config.url).href;
const image = new URL('/og.jpg', config.url).href;
const structuredData = post
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: post.title,
      description,
      mainEntityOfPage: canonical,
      url: canonical,
      datePublished: post.published.toISOString(),
      dateModified: (post.updated ?? post.published).toISOString(),
      author: {
        '@type': 'Person',
        name: config.author,
        url: new URL(config.pages.about.href, config.url).href,
      },
      publisher: { '@type': 'Person', name: config.author },
      keywords: post.tags.join(', '),
      inLanguage: config.language,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: config.name,
      url: config.url,
      description,
      inLanguage: config.language,
      author: { '@type': 'Person', name: config.author },
    };
---

<!doctype html>
<html
  lang={config.language}
  class="scrollbar-thumb-border scrollbar-track-transparent scrollbar-gutter-stable motion-safe:scroll-smooth sm:scrollbar-gutter-both"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={config.author} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow'}
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${config.name} RSS`}
      href="/rss.xml"
    />
    <meta property="og:type" content={post ? 'article' : 'website'} />
    <meta property="og:site_name" content={config.name} />
    <meta property="og:title" content={title ?? config.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={config.locale} />
    <meta property="og:image" content={image} />
    <meta
      property="og:image:alt"
      content={`${config.name} — ${config.pages.home.description}`}
    />
    {post && (
      <>
        <meta
          property="article:published_time"
          content={post.published.toISOString()}
        />
        <meta
          property="article:modified_time"
          content={(post.updated ?? post.published).toISOString()}
        />
      </>
    )}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title ?? config.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            root.dataset.theme = saved;
          }
        } catch {
          /* Use the system preference when storage is unavailable. */
        }
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
        root.classList.toggle(
          'dark',
          (root.dataset.theme ?? (prefersDark.matches ? 'dark' : 'light')) ===
            'dark',
        );
      })();
    </script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')}
    />
  </head>
  <body class="flex min-h-svh flex-col bg-background text-foreground">
    <a
      class="sr-only focus:not-sr-only focus:fixed focus:inset-s-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-background focus:px-3 focus:py-2 focus:text-accent-foreground"
      href="#main-content"
    >
      {config.common.skipToContent}
    </a>
    <Header />
    <main id="main-content" class="layout flex-1 py-8 sm:py-12" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
